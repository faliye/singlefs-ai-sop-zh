C publish

(*
 * 样本：写者先写数据、再立标志；读者先读标志、再读数据。
 *
 * singlefs-expect: Never
 * singlefs-models: none —— 样本：这一例只看对照组与绑定那一层
 *)

{}

P0(int *data, int *flag)
{
	WRITE_ONCE(*data, 1);
	smp_store_release(flag, 1);
}

P1(int *data, int *flag)
{
	int r0;
	int r1;

	r0 = smp_load_acquire(flag);
	r1 = READ_ONCE(*data);
}

exists (1:r0=1 /\ 1:r1=0)
