C commit-publish

(*
 * 事务提交的发布顺序：先写新块的内容，再写指向它的超级块。
 * 坏结果 = 读者看见了新的 generation，却读到旧的块内容
 *          （超级块指向一个内容还没可见的块 → 挂载时读到垃圾）。
 *
 * 这是 COW 文件系统最基本的一条序：整个「提交是原子的」都建立在它上面。
 *
 * P0 = 写者（提交事务）；P1 = 读者（挂载或并发读）。
 *
 * singlefs-expect: Never
 * singlefs-models: none —— 模板：演示一条 Never 怎么配它的对照组，不对应任何代码。
 *   项目写出实现这条序的代码之后，把这一行换成 <仓内路径>::<函数名>，再写一个读这个文件的测试。
 *)

{}

P0(int *blk, int *gen)
{
	WRITE_ONCE(*blk, 1);
	smp_wmb();
	WRITE_ONCE(*gen, 1);
}

P1(int *blk, int *gen)
{
	int r0;
	int r1;

	r0 = READ_ONCE(*gen);
	smp_rmb();
	r1 = READ_ONCE(*blk);
}

exists (1:r0=1 /\ 1:r1=0)
